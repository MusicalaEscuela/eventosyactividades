rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Solo el equipo autorizado. Antes bastaba con cualquier cuenta de Google;
    // se cerró al confirmar que este proyecto lo usa únicamente el personal
    // con acceso, igual que RIP (rip-musicala).
    function googleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email in [
          "alekcaballeromusic@gmail.com",
          "catalina.medina.leal@gmail.com",
          "imusicala@gmail.com",
          "adminmusicala@gmail.com",
          "musicalaasesor@gmail.com"
        ];
    }

    function isAdmin() {
      return googleUser()
        && request.auth.token.email in [
          "alekcaballeromusic@gmail.com",
          "catalina.medina.leal@gmail.com",
          "imusicala@gmail.com"
        ];
    }

    // Formato sin cuenta: el catálogo no contiene datos de estudiantes.
    // Las fichas se leen por un secreto aleatorio; nunca se pueden enumerar.
    function validDocenteToken(token) {
      return token.matches('^[a-f0-9]{64}$');
    }

    function docenteParentPath(token) {
      return /databases/$(database)/documents/fichasDocentes/$(token);
    }

    function docenteCatalogPath(eventoId) {
      return /databases/$(database)/documents/convocatoriasDocentes/$(eventoId);
    }

    function docenteActive(token) {
      return validDocenteToken(token)
        && exists(docenteParentPath(token))
        && get(docenteParentPath(token)).data.revocada == false;
    }

    function docenteWindow(data) {
      let catalog = get(docenteCatalogPath(data.eventoId)).data;
      let event = /databases/$(database)/documents/eventos/$(data.eventoId);
      return exists(event)
        && !(get(event).data.get('estado', '') in ['Realizado', 'No realizado', 'Archivado'])
        && (data.reabiertaHasta is timestamp && data.reabiertaHasta > request.time
          || catalog.abierta == true && catalog.cierreAt is timestamp && catalog.cierreAt > request.time);
    }

    function docenteText(data, key, max) {
      return data[key] is string && data[key].size() <= max;
    }

    function docenteParentKeys() {
      return ['eventoId', 'docenteId', 'docenteNombre', 'asistencia', 'disponibilidad',
        'apoyo', 'indicacionesGenerales', 'estado', 'revision', 'cantidadPresentaciones',
        'createdAt', 'updatedAt', 'revocada', 'reabiertaHasta', 'comentarioCoordinacion'];
    }

    function docenteParentValid(data) {
      return data.keys().hasAll(docenteParentKeys())
        && data.eventoId is string && data.eventoId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.docenteId is string && data.docenteId.matches('^[A-Za-z0-9_-]{1,100}$')
        && docenteText(data, 'docenteNombre', 160) && data.docenteNombre.size() > 0
        && data.asistencia in ['Sí', 'No', 'Por confirmar']
        && docenteText(data, 'disponibilidad', 2000) && docenteText(data, 'apoyo', 3000)
        && docenteText(data, 'indicacionesGenerales', 5000)
        && data.estado in ['Borrador', 'Enviado']
        && data.revision is int && data.revision >= 1
        && data.cantidadPresentaciones is int && data.cantidadPresentaciones >= 0 && data.cantidadPresentaciones <= 20
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.revocada == false && (data.reabiertaHasta == null || data.reabiertaHasta is timestamp)
        && docenteText(data, 'comentarioCoordinacion', 5000);
    }

    function docentePresentationValid(data, parent) {
      return data.keys().hasAll(['tipo', 'estudianteGrupo', 'integrantesTexto', 'areaArtisticaId',
          'instrumento', 'repertorio', 'duracionMin', 'cantidadObras', 'recursos', 'materialUrl', 'preparacion',
          'entrada', 'inicio', 'acompanamiento', 'cierre', 'observaciones', 'revision', 'updatedAt'])
        && data.keys().hasOnly(['tipo', 'estudianteGrupo', 'integrantesTexto', 'areaArtisticaId',
          'instrumento', 'repertorio', 'duracionMin', 'cantidadObras', 'recursos', 'materialUrl', 'preparacion',
          'entrada', 'inicio', 'acompanamiento', 'cierre', 'observaciones', 'revision', 'updatedAt', 'obrasJson', 'inscripcionId'])
        && (!('obrasJson' in data) || docenteText(data, 'obrasJson', 6000))
        && (!('inscripcionId' in data) || docenteText(data, 'inscripcionId', 100) && (data.inscripcionId == '' || data.inscripcionId.matches('^[A-Za-z0-9_-]{1,100}$')))
        && data.tipo in ['Individual', 'Ensamble']
        && data.areaArtisticaId in ['musica', 'danza', 'teatro', 'artes-plasticas']
        && docenteText(data, 'estudianteGrupo', 180) && docenteText(data, 'integrantesTexto', 3000)
        && docenteText(data, 'instrumento', 120) && docenteText(data, 'repertorio', 3000)
        && data.duracionMin is number && data.duracionMin >= 0 && data.duracionMin <= 120
        && data.cantidadObras is int && data.cantidadObras >= 1 && data.cantidadObras <= 20
        && docenteText(data, 'recursos', 2000) && docenteText(data, 'materialUrl', 1000)
        && (data.materialUrl == '' || data.materialUrl.matches('^https?://[^\\s]+$'))
        && docenteText(data, 'preparacion', 3000) && docenteText(data, 'entrada', 2000)
        && docenteText(data, 'inicio', 2000) && docenteText(data, 'acompanamiento', 3000)
        && docenteText(data, 'cierre', 2000) && docenteText(data, 'observaciones', 3000)
        && data.revision is int && data.revision == parent.revision && data.updatedAt == request.time
        && (parent.estado != 'Enviado' ||
          data.estudianteGrupo.size() > 0 && data.repertorio.size() > 0
          && (data.areaArtisticaId == 'artes-plasticas' || data.duracionMin > 0)
          && (data.tipo != 'Ensamble' || data.integrantesTexto.size() > 0)
          && (parent.asistencia != 'No' || data.preparacion.size() > 0 && data.inicio.size() > 0));
    }

    function docenteSubmissionValid(token, data) {
      let first = /databases/$(database)/documents/fichasDocentes/$(token)/presentaciones/p01;
      return data.estado != 'Enviado' || data.cantidadPresentaciones > 0
        && existsAfter(first) && docentePresentationValid(getAfter(first).data, data);
    }

    function docenteParentCreate(token) {
      let data = request.resource.data;
      let catalog = get(docenteCatalogPath(data.eventoId)).data;
      let reservation = /databases/$(database)/documents/convocatoriasDocentes/$(data.eventoId)/reservas/$(data.docenteId);
      return validDocenteToken(token) && data.keys().hasOnly(docenteParentKeys())
        && docenteParentValid(data) && data.revision == 1 && data.createdAt == request.time
        && data.reabiertaHasta == null && data.comentarioCoordinacion == ''
        && catalog.docentes[data.docenteId] == data.docenteNombre && docenteWindow(data)
        && existsAfter(reservation) && getAfter(reservation).data.fichaToken == token
        && getAfter(reservation).data.createdAt == request.time
        && docenteSubmissionValid(token, data);
    }

    function docenteParentUpdate(token) {
      let data = request.resource.data;
      return validDocenteToken(token) && resource.data.revocada == false
        && resource.data.estado in ['Borrador', 'Enviado', 'Requiere ajustes']
        && data.diff(resource.data).affectedKeys().hasOnly(['asistencia', 'disponibilidad', 'apoyo',
          'indicacionesGenerales', 'estado', 'revision', 'cantidadPresentaciones', 'updatedAt'])
        && docenteParentValid(data) && data.revision == resource.data.revision + 1
        && docenteWindow(data) && docenteSubmissionValid(token, data);
    }

    function docenteChildrenWindow(token) {
      let parent = getAfter(docenteParentPath(token)).data;
      return validDocenteToken(token) && parent.revocada == false
        && parent.estado in ['Borrador', 'Enviado'] && parent.updatedAt == request.time
        && docenteWindow(parent)
        && (!exists(docenteParentPath(token)) && parent.revision == 1
          || exists(docenteParentPath(token)) && get(docenteParentPath(token)).data.estado != 'Confirmado'
          && parent.revision == get(docenteParentPath(token)).data.revision + 1);
    }

    match /convocatoriasDocentes/{eventoId} {
      allow get, list: if true;
      allow create, update: if googleUser();
      allow delete: if isAdmin();

      match /reservas/{docenteId} {
        allow read, update: if googleUser();
        allow delete: if isAdmin();
        allow create: if googleUser() ||
          request.resource.data.keys().hasAll(['fichaToken', 'createdAt'])
          && request.resource.data.keys().hasOnly(['fichaToken', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && validDocenteToken(request.resource.data.fichaToken)
          && existsAfter(docenteParentPath(request.resource.data.fichaToken))
          && getAfter(docenteParentPath(request.resource.data.fichaToken)).data.eventoId == eventoId
          && getAfter(docenteParentPath(request.resource.data.fichaToken)).data.docenteId == docenteId
          && getAfter(docenteParentPath(request.resource.data.fichaToken)).data.createdAt == request.time;
      }
    }

    match /fichasDocentes/{token} {
      allow get: if googleUser() || validDocenteToken(token) && resource.data.revocada == false;
      allow list: if googleUser();
      allow delete: if isAdmin();
      allow create: if googleUser() || docenteParentCreate(token);
      allow update: if googleUser() || docenteParentUpdate(token);

      match /presentaciones/{presentacionId} {
        allow get, list: if googleUser() || docenteActive(token);
        allow create, update: if googleUser() || presentacionId.matches('^p(0[1-9]|1[0-9]|20)$')
          && docenteChildrenWindow(token)
          && docentePresentationValid(request.resource.data, getAfter(docenteParentPath(token)).data);
        allow delete: if isAdmin() || presentacionId.matches('^p(0[1-9]|1[0-9]|20)$')
          && docenteChildrenWindow(token);
      }
    }

    // App: seguimiento de eventos, actividades y muestras de proceso.
    // Ajusta esta regla si quieres permitir acceso a más correos del equipo.
    match /eventos/{eventoId} {
      allow read, create, update: if googleUser();
      allow delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read, create, update: if googleUser();
        allow delete: if isAdmin();
      }
    }

    // Consulta de grupo de colecciones.
    //
    // El seguimiento de estudiantes recorre las muestras de TODOS los eventos
    // con collectionGroup("muestras") para saber quién ya se presentó.
    //
    // Ese tipo de consulta NO queda cubierta por el match anidado de arriba:
    // al no ir atada a un evento padre concreto, Firestore exige una regla
    // propia con comodín recursivo. Sin esto la consulta falla con
    // permission-denied aunque el usuario sí pueda leer cada muestra de a una.
    //
    // Es solo lectura: crear, editar y borrar siguen pasando por la regla
    // anidada de eventos/{eventoId}/{subcollection}/{docId}.
    match /{path=**}/muestras/{muestraId} {
      allow read: if googleUser();
    }

    // Guía institucional: mismo equipo autorizado; sin acceso público.
    match /configuracion/muestrasProceso {
      allow read, create, update: if googleUser();
      allow delete: if isAdmin();
      match /anios/{anio} {
        allow read, create, update: if googleUser();
        allow delete: if isAdmin();
      }
      // Registro de auditoría: el cliente solo puede agregar entradas propias.
      match /historial/{cambio} {
        allow read: if googleUser();
        allow create: if googleUser()
          && request.resource.data.usuario == request.auth.token.email;
        allow update, delete: if isAdmin();
      }
    }

    // Una ruta por estudiante, área y proceso. Acceso exclusivo del equipo actual.
    function routeStageValid(stage) {
      return stage is map
        && stage.keys().hasAll(['estado', 'fecha', 'docente', 'evidencia', 'notas', 'excepcion', 'eventoId'])
        && stage.keys().hasOnly(['estado', 'fecha', 'docente', 'evidencia', 'notas', 'excepcion', 'eventoId'])
        && stage.estado in ['Pendiente', 'En preparación', 'Completada']
        && docenteText(stage, 'fecha', 10) && (stage.fecha == '' || stage.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && docenteText(stage, 'docente', 160) && docenteText(stage, 'evidencia', 1000)
        && (stage.evidencia == '' || stage.evidencia.matches('^https?://[^\\s]+$'))
        && docenteText(stage, 'notas', 1500) && docenteText(stage, 'excepcion', 1000)
        && docenteText(stage, 'eventoId', 200)
        && (stage.estado != 'Completada' || stage.fecha.size() == 10 && stage.docente.size() > 0);
    }

    function routeValid(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'areaId', 'nombre', 'cerrado', 'createdDate', 'etapas', 'revision', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'areaId', 'nombre', 'cerrado', 'createdDate', 'etapas', 'revision', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && docenteText(data, 'studentId', 200) && data.studentId.size() > 0
        && docenteText(data, 'studentName', 240) && data.studentName.size() > 0
        && docenteText(data, 'nombre', 200) && data.nombre.size() > 0
        && data.areaId in ['musica', 'danza', 'teatro', 'artes-plasticas']
        && data.cerrado is bool && data.createdDate is string && data.createdDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.revision is int && data.revision >= 1 && data.createdAt is timestamp
        && data.updatedBy == request.auth.token.email && data.updatedAt == request.time
        && data.etapas is map && data.etapas.keys().hasAll(['audio', 'video', 'recital', 'grande'])
        && data.etapas.keys().hasOnly(['audio', 'video', 'recital', 'grande'])
        && routeStageValid(data.etapas.audio) && routeStageValid(data.etapas.video)
        && routeStageValid(data.etapas.recital) && routeStageValid(data.etapas.grande);
    }

    match /rutasMuestras/{procesoId} {
      allow read: if googleUser();
      allow create: if googleUser() && routeValid(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email && request.resource.data.cerrado == false
        && request.resource.data.etapas.audio.estado == 'Pendiente' && request.resource.data.etapas.video.estado == 'Pendiente'
        && request.resource.data.etapas.recital.estado == 'Pendiente' && request.resource.data.etapas.grande.estado == 'Pendiente';
      allow update: if googleUser() && routeValid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etapas', 'cerrado', 'revision', 'updatedBy', 'updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
      match /historial/{cambioId} {
        allow read: if googleUser();
        allow create: if googleUser()
          && request.resource.data.keys().hasAll(['accion', 'etapa', 'anterior', 'nuevo', 'motivo', 'revision', 'usuario', 'at'])
          && request.resource.data.keys().hasOnly(['accion', 'etapa', 'anterior', 'nuevo', 'motivo', 'revision', 'usuario', 'at'])
          && docenteText(request.resource.data, 'accion', 100) && docenteText(request.resource.data, 'etapa', 20)
          && docenteText(request.resource.data, 'anterior', 10000) && docenteText(request.resource.data, 'nuevo', 10000)
          && docenteText(request.resource.data, 'motivo', 1000)
          && request.resource.data.usuario == request.auth.token.email && request.resource.data.at == request.time
          && request.resource.data.revision == getAfter(/databases/$(database)/documents/rutasMuestras/$(procesoId)).data.revision;
        allow update, delete: if false;
      }
    }

    // Bases maestras: viven fuera de los eventos y se reutilizan en todos.
    match /lugares/{lugarId} {
      allow read, create, update: if googleUser();
      allow delete: if isAdmin();
    }

    match /personas/{personaId} {
      allow read, create, update: if googleUser();
      allow delete: if isAdmin();
    }
  }
}
